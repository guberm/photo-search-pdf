<Window x:Class="PhotoSearchPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhotoSearch PDF" Width="820" Height="760" MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        AllowDrop="True" Drop="Window_Drop" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs" Margin="20" Background="Transparent" BorderThickness="0">
        <TabItem Header="1. Создать PDF">
            <Grid Margin="8,20,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="PhotoSearch PDF" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="Фотографии → PDF с OCR-поиском → вопросы через ChatGPT" FontSize="15" Foreground="#667085" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E4E7EC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Папка с фотографиями" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="InputFolderTextBox" TextChanged="InputFolderTextBox_TextChanged"
                                     ToolTip="Можно вставить путь или перетащить папку в окно"/>
                            <Button Grid.Column="1" Content="Выбрать…" Click="BrowseInput_Click"/>
                        </Grid>

                        <TextBlock Text="Итоговый PDF" FontWeight="SemiBold" FontSize="14" Margin="0,17,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputPdfTextBox"/>
                            <Button Grid.Column="1" Content="Сохранить как…" Click="BrowseOutput_Click"/>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Язык OCR" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,7"/>
                                <ComboBox x:Name="LanguageComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Русский + English" Tag="rus+eng"/>
                                    <ComboBoxItem Content="Русский" Tag="rus"/>
                                    <ComboBoxItem Content="English" Tag="eng"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,3">
                                <CheckBox x:Name="RecursiveCheckBox" Content="Включать подпапки" FontSize="14"
                                          Checked="RecursiveCheckBox_Changed" Unchecked="RecursiveCheckBox_Changed"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ImageCountTextBlock" Text="Выберите папку" Foreground="#667085" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Content="Создать searchable PDF" Click="Start_Click"
                            Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold" Margin="0"/>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена" Click="Cancel_Click" IsEnabled="False"/>
                    <Button x:Name="OpenButton" Grid.Column="2" Content="Открыть PDF" Click="Open_Click" IsEnabled="False"/>
                </Grid>

                <ProgressBar x:Name="ProgressBar" Grid.Row="3" Height="8" Minimum="0" Maximum="100" Margin="0,20,0,0"/>
                <TextBlock x:Name="StatusTextBlock" Grid.Row="4" Text="Готово к работе" Foreground="#475467" Margin="0,9,0,0"/>

                <Border Grid.Row="6" Background="#101828" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="#D0D5DD" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                </Border>

                <TextBlock Grid.Row="7" Margin="0,14,0,0" Foreground="#667085" FontSize="12"
                           Text="OCR и создание PDF выполняются локально. Рядом создаются .md, .txt и .ocr.json."/>
            </Grid>
        </TabItem>

        <TabItem Header="2. Вопросы к документу">
            <Grid Margin="8,20,8,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Вопросы по документу" FontSize="30" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="OpenAI через вашу подписку ChatGPT — без API key и отдельного API-биллинга"
                               FontSize="14" Foreground="#667085" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="#EFF6FF" CornerRadius="10" Padding="14" BorderBrush="#BFDBFE" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Подключение OpenAI" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                            <TextBlock x:Name="CodexStatusTextBlock" Text="Проверяю Codex CLI…" Foreground="#475467" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="RefreshCodexButton" Grid.Column="1" Content="Проверить" Click="RefreshCodex_Click"/>
                        <Button x:Name="LoginCodexButton" Grid.Column="2" Content="Войти через ChatGPT" Click="LoginCodex_Click"
                                Background="#2563EB" Foreground="White" BorderBrush="#2563EB"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="Документ" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="QuestionDocumentTextBox" ToolTip="PDF, созданный PhotoSearch PDF, или файл .ocr.json"/>
                        <Button Grid.Column="1" Content="Выбрать…" Click="BrowseQuestionDocument_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Text="Ваш вопрос" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,7"/>
                    <TextBox x:Name="QuestionTextBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" ToolTip="Например: Какие сроки оплаты указаны в договоре?"/>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="QuestionStatusTextBlock" Text="Готово к вопросу" Foreground="#475467" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ContextInfoTextBlock" Foreground="#667085" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelQuestionButton" Content="Отмена" Click="CancelQuestion_Click" IsEnabled="False"/>
                        <Button x:Name="AskButton" Content="Задать вопрос" Click="Ask_Click" Margin="8,0,0,0"
                                Background="#2563EB" Foreground="White" BorderBrush="#2563EB" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="5" Background="White" CornerRadius="10" Padding="14" Margin="0,16,0,0"
                        BorderBrush="#E4E7EC" BorderThickness="1">
                    <TextBox x:Name="AnswerTextBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" FontSize="14"/>
                </Border>

                <TextBlock Grid.Row="6" Margin="0,12,0,0" Foreground="#667085" FontSize="12" TextWrapping="Wrap"
                           Text="При вопросе выбранный OCR-текст отправляется в OpenAI. Фотографии и сам PDF не загружаются. Ответ формируется только по контексту и содержит ссылки на страницы."/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
